<Window x:Class="MyProgress.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <NavigationView x:Name="Nav" PaneDisplayMode="Auto" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" SelectionChanged="OnNav">
    <NavigationView.MenuItems>
      <NavigationViewItem Tag="chart" Icon="Library" />
      <NavigationViewItem Tag="stats" Icon="Calendar" />
      <NavigationViewItem Tag="settings" Icon="Setting" />
    </NavigationView.MenuItems>
    <ScrollViewer x:Name="Body" VerticalScrollBarVisibility="Auto" />
  </NavigationView>
</Window>
